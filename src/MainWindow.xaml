<Window x:Class="LersMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ЛЭРС УЧЁТ — Экспресс Мониторинг" 
        Height="880" Width="1440"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemBackground}"
        FontFamily="Segoe UI Variable Display, -apple-system, SF Pro Display, Segoe UI, Helvetica">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <sys:Double x:Key="AppFontSize">11</sys:Double>

        <SolidColorBrush x:Key="SystemBackground" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="LabelPrimary" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="LabelSecondary" Color="#86868B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0071E3"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#34C759"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF3B30"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9500"/>
        <SolidColorBrush x:Key="AccentGray" Color="#8E8E93"/>
        <SolidColorBrush x:Key="InputBackground" Color="#FBFBFD"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#FAFAFC"/>
        <SolidColorBrush x:Key="SelectionBackground" Color="#E8F2FE"/>
        <SolidColorBrush x:Key="SelectionForeground" Color="#1D1D1F"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <ToggleButton x:Name="toggleButton" Background="Transparent" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource LabelSecondary}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Placement="Bottom">
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleGreenButton" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButton}"><Setter Property="Background" Value="{DynamicResource AccentGreen}"/></Style>
        <Style x:Key="AppleRedButton" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButton}"><Setter Property="Background" Value="{DynamicResource AccentRed}"/></Style>
        
        <Style x:Key="AppleGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        </Style>

        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="12" Padding="12,5" Margin="0,0,6,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель подключения и глобальных настроек -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Сервер" FontSize="10" Foreground="{DynamicResource LabelSecondary}"/>
                            <TextBox x:Name="TxtHost" Width="120" Text="localhost"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Порт" FontSize="10" Foreground="{DynamicResource LabelSecondary}"/>
                            <TextBox x:Name="TxtPort" Width="55" Text="10000"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Логин" FontSize="10" Foreground="{DynamicResource LabelSecondary}"/>
                            <TextBox x:Name="TxtLogin" Width="90"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Пароль" FontSize="10" Foreground="{DynamicResource LabelSecondary}"/>
                            <PasswordBox x:Name="TxtPassword" Width="90"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkRemember" Content="Запомнить" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,12,6"/>
                        
                        <!-- Блок Темы и Авто-Темы -->
                        <CheckBox x:Name="ChkDarkMode" Content="🌙 Тёмная" VerticalAlignment="Bottom" Margin="0,0,6,6" Click="ChkDarkMode_Click"/>
                        <CheckBox x:Name="ChkAutoTheme" Content="⏱ Авто" ToolTip="Автоматическая смена по времени" VerticalAlignment="Bottom" Margin="0,0,4,6" Click="ChkAutoTheme_Click"/>
                        <Button Content="⚙" ToolTip="Настройка времени темы" Style="{StaticResource AppleGhostButton}" VerticalAlignment="Bottom" Margin="0,0,14,6" Click="BtnThemeSettings_Click"/>

                        <!-- Регулятор размера шрифта на всех экранах -->
                        <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Bottom" Margin="0,0,8,4" Padding="4,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Текст:" FontSize="10" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                <Button Content="A-" Style="{StaticResource AppleGhostButton}" Padding="4,0" Click="BtnFontDecrease_Click"/>
                                <TextBlock x:Name="TxtFontSizeDisplay" Text="11" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LabelPrimary}" VerticalAlignment="Center" Margin="4,0"/>
                                <Button Content="A+" Style="{StaticResource AppleGhostButton}" Padding="4,0" Click="BtnFontIncrease_Click"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Button x:Name="BtnConnect" Content="Подключиться" Style="{StaticResource ApplePrimaryButton}" Click="BtnConnect_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Переключение режимов -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,8">
                <RadioButton x:Name="TabAll" Content="Общий мониторинг" Style="{StaticResource TabNavButton}" IsChecked="True" Checked="TabMode_Checked"/>
                <RadioButton x:Name="TabSingle" Content="Мониторинг текущих" Style="{StaticResource TabNavButton}" Checked="TabMode_Checked"/>
                <RadioButton x:Name="TabDashboard" Content="Дашборд (Плитки)" Style="{StaticResource TabNavButton}" Checked="TabMode_Checked"/>
            </StackPanel>

            <!-- Экран 1: Общий мониторинг точек -->
            <Grid x:Name="ViewGeneral" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Margin="0,0,6,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Объекты и точки учёта" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LabelPrimary}" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBox x:Name="TxtSearch" Padding="6,4" Margin="0,0,0,6" ToolTip="Поиск" TextChanged="ApplyFilters_Changed"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbNode" Grid.Column="0" Margin="0,0,3,0" SelectionChanged="ApplyFilters_Changed"/>
                                <ComboBox x:Name="CmbSystemType" Grid.Column="1" Margin="3,0,0,0" SelectionChanged="ApplyFilters_Changed"/>
                            </Grid>
                        </StackPanel>
                        <ListBox Grid.Row="2" x:Name="ListPoints" SelectionMode="Multiple" DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"/>
                        <Border Grid.Row="3" Margin="0,6,0,0" Padding="0,6,0,0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Button Content="Выделить всё" Style="{StaticResource AppleGhostButton}" HorizontalAlignment="Left" Click="BtnSelectAll_Click"/>
                                <Button Content="Очистить" Style="{StaticResource AppleGhostButton}" Foreground="#FF3B30" HorizontalAlignment="Right" Click="BtnClearSelection_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Margin="6,0,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Текущие параметры" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="📈 Темп. график" Style="{StaticResource ApplePrimaryButton}" Background="{DynamicResource AccentBlue}" Margin="0,0,8,0" Click="BtnAssignTempChart_Click"/>
                                <Button x:Name="BtnSettings" Content="⚙ Границы" Style="{StaticResource ApplePrimaryButton}" Background="{DynamicResource AccentGray}" Margin="0,0,8,0" Click="BtnSettingsShared_Click"/>
                                <Button x:Name="BtnStartMonitor" Content="Опросить выбранные" Style="{StaticResource AppleGreenButton}" Click="BtnStartMonitor_Click" IsEnabled="False"/>
                                <Button x:Name="BtnCancelMonitor" Content="✕ Отмена" Style="{StaticResource AppleRedButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnCancelMonitor_Click"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Колонки:" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <CheckBox Content="Тнар" IsChecked="True" Click="ColumnToggle_Click"/>
                            <CheckBox Content="T1" IsChecked="True" Click="ColumnToggle_Click"/>
                            <CheckBox Content="T2" IsChecked="True" Click="ColumnToggle_Click"/>
                            <CheckBox Content="P1" IsChecked="True" Click="ColumnToggle_Click"/>
                            <CheckBox Content="P2" IsChecked="False" Click="ColumnToggle_Click"/>
                            <CheckBox Content="V1" IsChecked="False" Click="ColumnToggle_Click"/>
                            <CheckBox Content="V2" IsChecked="False" Click="ColumnToggle_Click"/>
                            <CheckBox Content="M1" IsChecked="True" Click="ColumnToggle_Click"/>
                            <CheckBox Content="M2" IsChecked="True" Click="ColumnToggle_Click"/>
                            <CheckBox Content="Q"  IsChecked="True" Click="ColumnToggle_Click"/>
                        </StackPanel>

                        <Border Grid.Row="2" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <DataGrid x:Name="GridResults" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Объект учёта" Binding="{Binding NodeTitle}" Width="140"/>
                                    <DataGridTextColumn Header="Точка" Binding="{Binding Title}" Width="120"/>
                                    <DataGridTextColumn Header="Время" Binding="{Binding DeviceTime, StringFormat=\{0:dd.MM HH:mm\}}" Width="90"/>
                                    <DataGridTextColumn Header="Тнар (°C)" Binding="{Binding OutdoorTemp, StringFormat=\{0:F1\}}" Width="65"/>
                                    <DataGridTextColumn Header="T1 (°C)" Binding="{Binding T1, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="T2 (°C)" Binding="{Binding T2, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="P1 (атм)" Binding="{Binding P1, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="P2 (атм)" Binding="{Binding P2, StringFormat=\{0:F1\}}" Width="60" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="V1 (м³/ч)" Binding="{Binding V1, StringFormat=\{0:F2\}}" Width="65" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="V2 (м³/ч)" Binding="{Binding V2, StringFormat=\{0:F2\}}" Width="65" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="M1 (т)" Binding="{Binding M1, StringFormat=\{0:F2\}}" Width="65"/>
                                    <DataGridTextColumn Header="M2 (т)" Binding="{Binding M2, StringFormat=\{0:F2\}}" Width="65"/>
                                    <DataGridTextColumn Header="Q (Гкал)" Binding="{Binding Q, StringFormat=\{0:F3\}}" Width="65"/>
                                    <DataGridTextColumn Header="График / ΔT" Binding="{Binding TempChartDeviationText}" Width="100"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Экран 2: Мониторинг текущих -->
            <Grid x:Name="ViewTrend" Grid.Row="2" Visibility="Collapsed">
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Точка:" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbTrendPoint" Width="320" DisplayMemberPath="DisplayName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Мин:" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbTrendDuration" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Очистить" Style="{StaticResource AppleGhostButton}" Margin="0,0,10,0" Click="BtnClearTrend_Click"/>
                                <Button x:Name="BtnStartTrend" Content="▶ Запуск" Style="{StaticResource AppleGreenButton}" Click="BtnStartTrend_Click"/>
                                <Button x:Name="BtnStopTrend" Content="⏹ Стоп" Style="{StaticResource AppleRedButton}" Visibility="Collapsed" Click="BtnStopTrend_Click"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <DataGrid x:Name="GridTrend" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время прибора" Binding="{Binding DeviceTime, StringFormat=\{0:HH:mm:ss\}}" Width="100"/>
                                    <DataGridTextColumn Header="Тнар" Binding="{Binding OutdoorTemp, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="T1" Binding="{Binding T1, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="T2" Binding="{Binding T2, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="P1" Binding="{Binding P1, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="P2" Binding="{Binding P2, StringFormat=\{0:F1\}}" Width="60"/>
                                    <DataGridTextColumn Header="V1" Binding="{Binding V1, StringFormat=\{0:F2\}}" Width="65"/>
                                    <DataGridTextColumn Header="V2" Binding="{Binding V2, StringFormat=\{0:F2\}}" Width="65"/>
                                    <DataGridTextColumn Header="M1" Binding="{Binding M1, StringFormat=\{0:F2\}}" Width="65"/>
                                    <DataGridTextColumn Header="M2" Binding="{Binding M2, StringFormat=\{0:F2\}}" Width="65"/>
                                    <DataGridTextColumn Header="Q" Binding="{Binding Q, StringFormat=\{0:F3\}}" Width="70"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Экран 3: Дашборд (Плитки) с фильтрацией характеристик и адаптивной сеткой -->
            <Grid x:Name="ViewDashboard" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Margin="0,0,6,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Точки для Дашборда" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LabelPrimary}" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBox x:Name="TxtSearchDashboard" Padding="6,4" Margin="0,0,0,6" ToolTip="Поиск" TextChanged="ApplyFiltersDashboard_Changed"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbNodeDashboard" Grid.Column="0" Margin="0,0,3,0" SelectionChanged="ApplyFiltersDashboard_Changed"/>
                                <ComboBox x:Name="CmbSystemTypeDashboard" Grid.Column="1" Margin="3,0,0,0" SelectionChanged="ApplyFiltersDashboard_Changed"/>
                            </Grid>
                        </StackPanel>
                        <ListBox Grid.Row="2" x:Name="ListPointsDashboard" SelectionMode="Multiple" DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"/>
                        <Border Grid.Row="3" Margin="0,6,0,0" Padding="0,6,0,0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Button Content="Выделить всё" Style="{StaticResource AppleGhostButton}" HorizontalAlignment="Left" Click="BtnSelectAllDashboard_Click"/>
                                <Button Content="Очистить" Style="{StaticResource AppleGhostButton}" Foreground="#FF3B30" HorizontalAlignment="Right" Click="BtnClearSelectionDashboard_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Правая колонка: Ультракомпактные плитки -->
                <Border Grid.Column="1" Background="Transparent" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель управления дашбордом и фильтром отображаемых характеристик -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Автоопрос (мин):" FontSize="11" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbDashboardInterval" Width="55" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Фильтр характеристик в плитках (Пункт 2) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="Показывать:" FontSize="11" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox x:Name="ChkDashShowOutdoor" Content="Тнар" IsChecked="True" Click="DashFilter_Click" ToolTip="Температура наружного воздуха"/>
                                    <CheckBox x:Name="ChkDashShowTemp" Content="t₁/t₂" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashShowPress" Content="P" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashShowVolume" Content="V (м³)" IsChecked="False" Click="DashFilter_Click" ToolTip="Включить/выключить отображение кубов"/>
                                    <CheckBox x:Name="ChkDashShowMass" Content="M (т)" IsChecked="True" Click="DashFilter_Click"/>
                                    <CheckBox x:Name="ChkDashShowHeat" Content="Q" IsChecked="True" Click="DashFilter_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="📈 График" Style="{StaticResource ApplePrimaryButton}" Background="{DynamicResource AccentBlue}" Margin="0,0,6,0" Click="BtnAssignTempChart_Click"/>
                                    <Button x:Name="BtnSettingsDashboard" Content="⚙ Границы" Style="{StaticResource ApplePrimaryButton}" Background="{DynamicResource AccentGray}" Margin="0,0,6,0" Click="BtnSettingsShared_Click"/>
                                    <Button x:Name="BtnStartDashboard" Content="▶ Автоопрос" Style="{StaticResource AppleGreenButton}" Click="BtnStartDashboard_Click" IsEnabled="False"/>
                                    <Button x:Name="BtnStopDashboard" Content="⏹ Стоп" Style="{StaticResource AppleRedButton}" Margin="6,0,0,0" Visibility="Collapsed" Click="BtnStopDashboard_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Список плиток объектов (Адаптивная плотная сетка Masonry/Wrap) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsDashboard">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Плитка: динамическая ширина в зависимости от количества точек (185px или 375px) -->
                                        <Border x:Name="TileBorder" Width="185" Background="{Binding TileBackground}" CornerRadius="6" Margin="0,0,6,6" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Шапка объекта: название + Тнар + статус -->
                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding NodeTitle}" Foreground="{Binding TileForeground}" FontSize="{DynamicResource AppFontSize}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding NodeTitle}"/>
                                                    
                                                    <!-- Отображение наружного воздуха (Пункт 5) -->
                                                    <Border Grid.Column="1" Background="#33000000" CornerRadius="4" Padding="4,1" Margin="3,0,0,0"
                                                            Visibility="{Binding DataContext.ShowOutdoorVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <TextBlock Text="{Binding NodeOutdoorTempText}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Точки учёта на объекте -->
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Points}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#26000000" CornerRadius="4" Padding="4,3" Margin="0,0,0,3">
                                                                <StackPanel>
                                                                    <!-- Имя точки + темп. график/дельта -->
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding TempChartDeviationText}" Foreground="#FFEB3B" FontSize="9" FontWeight="Bold" Margin="4,0,0,0"/>
                                                                    </Grid>

                                                                    <!-- Строка t1/t2 (скрывается чекбоксом) -->
                                                                    <Grid Visibility="{Binding DataContext.ShowTempVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,1">
                                                                        <TextBlock Text="t₁ / t₂:" FontSize="9" Opacity="0.75" Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"/>
                                                                        <TextBlock HorizontalAlignment="Right" FontSize="{DynamicResource AppFontSize}" FontWeight="Bold">
                                                                            <Run Text="{Binding T1, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding T1DashForeground}"/><Run Text="/" Foreground="#80FFFFFF"/><Run Text="{Binding T2, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding T2DashForeground}"/>
                                                                        </TextBlock>
                                                                    </Grid>

                                                                    <!-- Строка Давлений P1/P2 -->
                                                                    <Grid Visibility="{Binding DataContext.ShowPressVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,1">
                                                                        <TextBlock Text="P₁ / P₂:" FontSize="9" Opacity="0.75" Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"/>
                                                                        <TextBlock HorizontalAlignment="Right" FontSize="{DynamicResource AppFontSize}" FontWeight="Bold">
                                                                            <Run Text="{Binding P1, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding P1DashForeground}"/><Run Text="/" Foreground="#80FFFFFF"/><Run Text="{Binding P2, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding P2DashForeground}"/>
                                                                        </TextBlock>
                                                                    </Grid>

                                                                    <!-- Строка Объемов V1/V2 (Кубы) - по умолчанию выключена -->
                                                                    <Grid Visibility="{Binding DataContext.ShowVolumeVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,1">
                                                                        <TextBlock Text="V₁ / V₂ м³:" FontSize="9" Opacity="0.75" Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"/>
                                                                        <TextBlock HorizontalAlignment="Right" FontSize="{DynamicResource AppFontSize}" FontWeight="Bold">
                                                                            <Run Text="{Binding V1, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding V1DashForeground}"/><Run Text="/" Foreground="#80FFFFFF"/><Run Text="{Binding V2, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding V2DashForeground}"/>
                                                                        </TextBlock>
                                                                    </Grid>

                                                                    <!-- Строка Массы M1/M2 -->
                                                                    <Grid Visibility="{Binding DataContext.ShowMassVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,1">
                                                                        <TextBlock Text="M₁ / M₂ т:" FontSize="9" Opacity="0.75" Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"/>
                                                                        <TextBlock HorizontalAlignment="Right" FontSize="{DynamicResource AppFontSize}" FontWeight="Bold">
                                                                            <Run Text="{Binding M1, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding M1DashForeground}"/><Run Text="/" Foreground="#80FFFFFF"/><Run Text="{Binding M2, StringFormat=\{0:F1\}, TargetNullValue='-'}" Foreground="{Binding M2DashForeground}"/>
                                                                        </TextBlock>
                                                                    </Grid>

                                                                    <!-- Строка Тепла Q -->
                                                                    <Grid Visibility="{Binding DataContext.ShowHeatVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                        <TextBlock Text="Q Гкал:" FontSize="9" Opacity="0.75" Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"/>
                                                                        <TextBlock Text="{Binding Q, StringFormat=\{0:F3\}, TargetNullValue='-'}" HorizontalAlignment="Right" FontSize="{DynamicResource AppFontSize}" FontWeight="Bold" Foreground="{Binding QDashForeground}"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Подвал плитки: время обновления -->
                                                <TextBlock Grid.Row="2" Text="{Binding MaxDeviceTime, StringFormat='{0:HH:mm}'}" 
                                                           Foreground="{Binding TileForeground}" FontSize="9" Opacity="0.75" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Адаптивное расширение плитки: если точек > 2 или показано много характеристик, плитка занимает 2 модуля (375 px) -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWideTile}" Value="True">
                                                <Setter TargetName="TileBorder" Property="Width" Value="375"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Статус бар -->
            <Border Grid.Row="3" Margin="2,8,2,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Готово к работе" FontSize="11" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно настройки авто-темы (Пункт 4) -->
        <Grid x:Name="OverlayThemeSettings" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="120">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="320">
                <StackPanel>
                    <TextBlock Text="Настройка расписания темы" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" Foreground="{DynamicResource LabelPrimary}"/>
                    <TextBlock Text="Время включения тёмной темы (ЧЧ:ММ):" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDarkStart" Text="20:00" Margin="0,0,0,10"/>
                    <TextBlock Text="Время включения светлой темы (ЧЧ:ММ):" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLightStart" Text="07:00" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Закрыть" Click="BtnSaveThemeSettings_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно назначения температурного графика (Пункт 5) -->
        <Grid x:Name="OverlayTempChart" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="110">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="360">
                <StackPanel>
                    <TextBlock x:Name="TxtTempChartTitle" Text="Назначение темп. графика" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource LabelPrimary}"/>
                    <TextBlock x:Name="TxtTempChartSubtitle" Text="Выберите график для расчета отклонений" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,12,0"/>
                    
                    <TextBlock Text="Температурный график:" FontSize="11" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbTempChartPresets" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Сбросить график" Click="BtnClearTempChart_Click" Margin="0,0,8,0" Style="{StaticResource AppleGhostButton}" Foreground="#FF3B30"/>
                        <Button Content="Отмена" Click="BtnCancelTempChart_Click" Margin="0,0,8,0" Style="{StaticResource AppleGhostButton}"/>
                        <Button Content="Применить" Click="BtnApplyTempChart_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Модальное окно настройки границ -->
        <Grid x:Name="OverlayLimits" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="100">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="400">
                <StackPanel>
                    <TextBlock x:Name="TxtLimitsTitle" Text="Границы" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2" Foreground="{DynamicResource LabelPrimary}"/>
                    <TextBlock x:Name="TxtLimitsSubtitle" Text="Пустые поля не изменят текущие значения точек" FontSize="10" Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Мин." Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,6" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="Макс." Foreground="{DynamicResource LabelSecondary}" Margin="0,0,0,6" FontSize="11"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="T1 (°C)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtT1Min" Grid.Row="1" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtT1Max" Grid.Row="1" Grid.Column="2" Margin="0,0,0,6"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="T2 (°C)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtT2Min" Grid.Row="2" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtT2Max" Grid.Row="2" Grid.Column="2" Margin="0,0,0,6"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="T3 (°C)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtT3Min" Grid.Row="3" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtT3Max" Grid.Row="3" Grid.Column="2" Margin="0,0,0,6"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="P1 (атм)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtP1Min" Grid.Row="4" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtP1Max" Grid.Row="4" Grid.Column="2" Margin="0,0,0,6"/>
                            
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="P2 (атм)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtP2Min" Grid.Row="5" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtP2Max" Grid.Row="5" Grid.Column="2" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="V1 (м³/ч)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtV1Min" Grid.Row="6" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtV1Max" Grid.Row="6" Grid.Column="2" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="V2 (м³/ч)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtV2Min" Grid.Row="7" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtV2Max" Grid.Row="7" Grid.Column="2" Margin="0,0,0,6"/>
                            
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="M1 (т)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtM1Min" Grid.Row="8" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtM1Max" Grid.Row="8" Grid.Column="2" Margin="0,0,0,6"/>
                            
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="M2 (т)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtM2Min" Grid.Row="9" Grid.Column="1" Margin="0,0,6,6"/>
                            <TextBox x:Name="TxtM2Max" Grid.Row="9" Grid.Column="2" Margin="0,0,0,6"/>
                            
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Q (Гкал)" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox x:Name="TxtQMin" Grid.Row="10" Grid.Column="1" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtQMax" Grid.Row="10" Grid.Column="2" Margin="0,0,0,0"/>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="BtnCancelLimits_Click" Margin="0,0,8,0" Style="{StaticResource AppleGhostButton}"/>
                        <Button Content="Применить" Click="BtnSaveLimits_Click" Style="{StaticResource ApplePrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
