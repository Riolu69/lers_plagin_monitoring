<Window x:Class="LersMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ЛЭРС УЧЁТ — Мониторинг" 
        Height="740" Width="1200"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7"
        FontFamily="Segoe UI Variable Display, -apple-system, SF Pro Display, Segoe UI, Helvetica">

    <Window.Resources>
        <SolidColorBrush x:Key="SystemBackground" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="LabelPrimary" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="LabelSecondary" Color="#86868B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0071E3"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#34C759"/>
        <SolidColorBrush x:Key="InputBackground" Color="#FBFBFD"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource LabelPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource LabelPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ApplePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleGreenButton" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButton}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F2F2F7"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFBFD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource LabelPrimary}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FAFAFC"/>
            <Setter Property="Foreground" Value="{StaticResource LabelSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" CornerRadius="14" Padding="16,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Сервер" FontSize="11" Foreground="{StaticResource LabelSecondary}" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtHost" Width="130" Text="localhost"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Порт" FontSize="11" Foreground="{StaticResource LabelSecondary}" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtPort" Width="65" Text="10000"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Логин" FontSize="11" Foreground="{StaticResource LabelSecondary}" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtLogin" Width="100"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Пароль" FontSize="11" Foreground="{StaticResource LabelSecondary}" Margin="2,0,0,4"/>
                        <PasswordBox x:Name="TxtPassword" Width="100"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkRemember" Content="Запомнить" IsChecked="True" 
                              VerticalAlignment="Bottom" Margin="0,0,10,8" 
                              FontSize="12" Foreground="{StaticResource LabelSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <Button x:Name="BtnConnect" Content="Подключиться" 
                            Style="{StaticResource ApplePrimaryButton}" 
                            Margin="0,0,10,0" Click="BtnConnect_Click"/>
                    <Button x:Name="BtnStartMonitor" Content="Опросить выбранные" 
                            Style="{StaticResource AppleGreenButton}" 
                            Click="BtnStartMonitor_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая карточка: Точки учёта -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="14" Margin="0,0,8,0" Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Объекты и точки учёта" FontWeight="SemiBold" FontSize="14" 
                               Foreground="{StaticResource LabelPrimary}" Margin="2,0,0,8"/>

                    <TextBox Grid.Row="1" x:Name="TxtSearch" Margin="0,0,0,10" Padding="8,5" 
                             TextChanged="TxtSearch_TextChanged" />

                    <ListBox Grid.Row="2" x:Name="ListPoints" SelectionMode="Multiple" 
                             DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F2F2F7"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E8F2FE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Правая карточка: Таблица и фильтр колонок -->
            <Border Grid.Column="1" Background="{StaticResource CardBackground}" CornerRadius="14" Margin="8,0,0,0" Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Текущие параметры" FontWeight="SemiBold" FontSize="14" 
                                   Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center"/>
                        
                        <!-- Фильтры отображения колонок -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Скрыть/Показать:" FontSize="12" Foreground="{StaticResource LabelSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <CheckBox Content="T1" IsChecked="True" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="T2" IsChecked="True" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="T3" IsChecked="False" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="P1" IsChecked="True" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="P2" IsChecked="False" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="V1" IsChecked="True" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="V2" IsChecked="False" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="M1" IsChecked="False" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="M2" IsChecked="False" Margin="0,0,6,0" Click="ColumnToggle_Click"/>
                            <CheckBox Content="Q"  IsChecked="False" Margin="0,0,0,0" Click="ColumnToggle_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                        <DataGrid x:Name="GridResults" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Объект учёта" Binding="{Binding NodeTitle}" Width="160"/>
                                <DataGridTextColumn Header="Точка" Binding="{Binding Title}" Width="120"/>
                                <DataGridTextColumn Header="Время прибора" Binding="{Binding DeviceTime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                                
                                <DataGridTextColumn Header="T1 (°C)" Binding="{Binding T1, StringFormat=\{0:F2\}}" Width="65"/>
                                <DataGridTextColumn Header="T2 (°C)" Binding="{Binding T2, StringFormat=\{0:F2\}}" Width="65"/>
                                <DataGridTextColumn Header="T3 (°C)" Binding="{Binding T3, StringFormat=\{0:F2\}}" Width="65" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="P1 (атм)" Binding="{Binding P1, StringFormat=\{0:F2\}}" Width="65"/>
                                <DataGridTextColumn Header="P2 (атм)" Binding="{Binding P2, StringFormat=\{0:F2\}}" Width="65" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="V1 (м³/ч)" Binding="{Binding V1, StringFormat=\{0:F3\}}" Width="70"/>
                                <DataGridTextColumn Header="V2 (м³/ч)" Binding="{Binding V2, StringFormat=\{0:F3\}}" Width="70" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="M1 (т)" Binding="{Binding M1, StringFormat=\{0:F3\}}" Width="70" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="M2 (т)" Binding="{Binding M2, StringFormat=\{0:F3\}}" Width="70" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Q (Гкал)" Binding="{Binding Q, StringFormat=\{0:F3\}}" Width="70" Visibility="Collapsed"/>
                                
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <Border Grid.Row="2" Margin="4,12,4,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus" Text="Готово к подключению" FontSize="12" Foreground="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
